# Copy to apps/web/.env.local for the web app. Never commit a populated copy.
DATABASE_URL="postgresql://eventpass:password@localhost:5432/eventpass?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
QR_SIGNING_SECRET="replace-with-a-different-32-character-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_EVENT_TICKET_ADDRESS=""
# Circle-issued Base Sepolia test USDC, verified against Circle's address list (2026-10-11).
NEXT_PUBLIC_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
# Set this to the EventTicket deployment transaction's block number.
INDEXER_START_BLOCK=""
# Optional: only these SIWE-authenticated wallets receive platform admin rights.
PLATFORM_ADMIN_WALLETS=""
# Required for Vercel Blob banner uploads.
BLOB_READ_WRITE_TOKEN=""
# Protect scheduled indexing requests. Use a long random value.
CRON_SECRET=""
# Worker-only. Example: https://your-staging-domain/api/index
INDEXER_URL=""
INDEXER_INTERVAL_MS="15000"
# Demo is opt-in and never treated as purchased or onchain data.
DEMO_MODE="false"
